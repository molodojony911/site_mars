# Скопировать в .env.production на сервере, заполнить реальными значениями.
# .env.production НЕ коммитить в репозиторий.

HOST_PORT=80
IMAGE_TAG=latest

# --- Требуется от заказчика/владельца сервера для выката (сейчас НЕ ПРЕДОСТАВЛЕНО) ---
SERVER_IP=              # IP или хост прод-сервера
SSH_USER=                # пользователь для SSH-деплоя
SSH_PORT=22
SSH_KEY_PATH=            # путь к приватному ключу / secret в CI (GitHub Actions secret)
DOMAIN=                  # доменное имя сайта (для nginx server_name и TLS)
CERTBOT_EMAIL=           # email для выпуска Let's Encrypt сертификата
